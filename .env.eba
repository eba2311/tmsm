# ==========================================
# AWS ELASTIC BEANSTALK ENVIRONMENT
# Arba Minch Transport Management System
# ==========================================

# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=production
PORT=4000

# ==========================================
# Frontend / CORS Configuration
# ==========================================
# Replace with your production domain
FRONTEND_URL=https://tmsm-app.com
CORS_ORIGIN=https://tmsm-app.com

# ==========================================
# PostgreSQL Database Configuration (RDS)
# ==========================================
# Format: postgresql://username:password@host:5432/database
# Required: Set this to your actual RDS endpoint before deployment
DATABASE_URL=postgresql://postgres:mysecurepassword123@tmsm-db.c9akciq32.us-east-1.rds.amazonaws.com:5432/tmsm

# RDS SSL Configuration
DB_POOL_MAX=20
DB_SSL=true

# ==========================================
# JWT Authentication Secrets
# ==========================================
# CRITICAL: Generate and store these in AWS Systems Manager Parameter Store or Secrets Manager
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=7f8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f
JWT_REFRESH_SECRET=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# Rate Limiting & Security
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10000

# ==========================================
# Redis Configuration (ElastiCache)
# ==========================================
# Format: redis://username:password@your-elasticache-endpoint.ng.0001.use1.cache.amazonaws.com:6379
# Example: redis://default:password@tmsm-cache.abc123.ng.0001.use1.cache.amazonaws.com:6379
REDIS_URL=redis://default:password123@tmsm-cache.abc123.ng.0001.use1.cache.amazonaws.com:6379

# ==========================================
# Logging Configuration
# ==========================================
LOG_LEVEL=info

# ==========================================
# Email Configuration (SES - Optional)
# ==========================================
# Using AWS SES for email delivery
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=your-ses-smtp-user
SMTP_PASS=your-ses-smtp-password
SMTP_FROM=noreply@your-domain.com
SMTP_SECURE=true

# ==========================================
# AWS Configuration
# ==========================================
# These are automatically handled by Elastic Beanstalk IAM role
AWS_REGION=us-east-1

# ==========================================
# S3 Configuration (for file uploads/storage)
# ==========================================
AWS_S3_BUCKET=tmsm-uploads-prod
AWS_S3_REGION=us-east-1
AWS_S3_ACL=private
UPLOAD_DIR=/uploads

# ==========================================
# File Upload Configuration
# ==========================================
MAX_FILE_SIZE=52428800

# ==========================================
# API Configuration
# ==========================================
API_PREFIX=/api/v1
API_VERSION=1.0.0

# ==========================================
# Session Configuration
# ==========================================
SESSION_SECRET=9z8y7x6w5v4u3t2s1r0q9p8o7n6m5l4k3j2i1h0g9f8e7d6c5b4a3z2y1x0w
SESSION_MAX_AGE=86400000

# ==========================================
# CloudWatch Logs (optional)
# ==========================================
CLOUDWATCH_LOG_GROUP=/aws/elasticbeanstalk/tmsm
CLOUDWATCH_LOG_STREAM=app.log

# ==========================================
# Health Check Configuration
# ==========================================
HEALTH_CHECK_URL=/api/v1/health
HEALTH_CHECK_INTERVAL=30

# ==========================================
# Auto Scaling Configuration (optional)
# ==========================================
MIN_INSTANCES=2
MAX_INSTANCES=10
TARGET_CPU_UTILIZATION=70

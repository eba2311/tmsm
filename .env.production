# ==========================================
# DEPLOYMENT ENVIRONMENT VARIABLES
# Arba Minch Transport Management System
# ==========================================

# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=production
PORT=4000

# ==========================================
# Frontend / CORS Configuration
# ==========================================
# Update these with your actual production domain
FRONTEND_URL=https://your-production-domain.com
CORS_ORIGIN=https://your-production-domain.com

# ==========================================
# PostgreSQL Database Configuration
# ==========================================
# Format: postgresql://username:password@host:port/database?sslmode=require
# For production, ensure SSL is enabled
# Example: postgresql://user:password@db.render.com:5432/tmsm?sslmode=require
DATABASE_URL=postgresql://user:password@your-db-host:5432/tmsm?sslmode=require

# Database pool configuration for production
DB_POOL_MAX=20
DB_SSL=true

# ==========================================
# JWT Authentication Secrets
# ==========================================
# CRITICAL: Generate strong random secrets using:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Never commit real secrets to version control
JWT_SECRET=your-strong-random-64-byte-hex-secret-here
JWT_REFRESH_SECRET=your-different-strong-random-64-byte-hex-secret-here
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# Rate Limiting & Security
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10000

# ==========================================
# Redis Configuration (Optional but Recommended)
# ==========================================
# For production, use a managed Redis service
# Example: redis://user:password@redis-host:6379
REDIS_URL=redis://localhost:6379

# ==========================================
# Logging Configuration
# ==========================================
LOG_LEVEL=info

# ==========================================
# Email Configuration (Optional)
# ==========================================
# SMTP_HOST=your-smtp-host
# SMTP_PORT=587
# SMTP_USER=your-email
# SMTP_PASS=your-password
# SMTP_FROM=noreply@your-domain.com

# ==========================================
# File Upload Configuration
# ==========================================
MAX_FILE_SIZE=52428800
UPLOAD_DIR=/uploads

# ==========================================
# AWS S3 Configuration (Optional - for file storage)
# ==========================================
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_S3_BUCKET=your-bucket-name

# ==========================================
# API Configuration
# ==========================================
API_PREFIX=/api/v1
API_VERSION=1.0.0

# ==========================================
# Session Configuration
# ==========================================
SESSION_SECRET=your-strong-random-session-secret-here
SESSION_MAX_AGE=86400000

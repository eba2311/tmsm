option_settings:
  # Node.js Configuration
  nodejs:
    ProxyServer: nginx
    GzipCompression: true
  
  # Environment Variables - these will be applied by Elastic Beanstalk
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    PORT: 4002
    LOG_LEVEL: info

  # Instance Configuration
  aws:ec2:instances:
    InstanceTypes: t3.small,t3.medium,t3.large

  # Auto Scaling
  aws:autoscaling:asg:
    MinSize: 2
    MaxSize: 10
    Cooldown: 300

  # Load Balancer
  aws:elasticbeanstalk:environment:
    EnvironmentType: LoadBalanced
    LoadBalancerType: application
    ServiceRole: aws-elasticbeanstalk-service-role
    InstanceRole: aws-elasticbeanstalk-ec2-role

  # Listener Configuration
  aws:elbv2:listener:default:
    Protocol: HTTP
    InstancePort: 4002
    InstanceProtocol: HTTP

  # HTTPS Listener (requires certificate)
  aws:elbv2:listener:443:
    Protocol: HTTPS
    InstancePort: 4002
    InstanceProtocol: HTTP
    SSLCertificateArns: arn:aws:acm:us-east-1:your-account-id:certificate/your-cert-id
    Rules: default

  # CloudWatch Logs
  aws:elasticbeanstalk:cloudwatch:logs:
    StreamLogs: true
    DeleteOnTerminate: false
    RetentionInDays: 7

files:
  "/opt/elasticbeanstalk/tasks/bundlelogs.d/01_app.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      /var/log/app.log

container_commands:
  01_install_dependencies:
    command: "npm install --production"
    ignoreErrors: false
  02_migrate_database:
    command: "npm run migrate || true"
    leader_only: true
  03_seed_database:
    command: "npm run seed || true"
    leader_only: true
  04_npm_build:
    command: "npm run build || true"
    ignoreErrors: false

commands:
  01_update_nginx:
    command: |
      cp /etc/nginx/conf.d/elasticbeanstalk/01_proxy.conf /etc/nginx/conf.d/elasticbeanstalk/01_proxy.conf.bak

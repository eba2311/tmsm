# ==========================================
# ENVIRONMENT VARIABLES TEMPLATE
# Arba Minch Transport Management System
# Copy this to .env and fill in your values
# ==========================================

# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=development
PORT=4000

# ==========================================
# Frontend / CORS Configuration
# ==========================================
FRONTEND_URL=http://localhost:5177
CORS_ORIGIN=http://localhost:5177

# ==========================================
# PostgreSQL Database Configuration
# ==========================================
# Local: postgresql://postgres:password@localhost:5432/tmsm
# Production: postgresql://user:password@host:5432/tmsm?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/tmsm

# Database pool configuration
DB_POOL_MAX=10
DB_SSL=false

# ==========================================
# JWT Authentication Secrets
# ==========================================
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate-strong-random-64-byte-hex-secret-here
JWT_REFRESH_SECRET=generate-strong-random-64-byte-hex-secret-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# Rate Limiting & Security
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# Redis Configuration (Optional)
# ==========================================
REDIS_URL=redis://localhost:6379

# ==========================================
# Logging Configuration
# ==========================================
LOG_LEVEL=debug

# ==========================================
# Email Configuration (Optional)
# ==========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@tmsm.com

# ==========================================
# File Upload Configuration
# ==========================================
MAX_FILE_SIZE=52428800
UPLOAD_DIR=/uploads

# ==========================================
# AWS S3 Configuration (Optional)
# ==========================================
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_S3_BUCKET=your-bucket-name

# ==========================================
# API Configuration
# ==========================================
API_PREFIX=/api/v1
API_VERSION=1.0.0

# ==========================================
# Session Configuration
# ==========================================
SESSION_SECRET=generate-strong-random-secret-here
SESSION_MAX_AGE=86400000

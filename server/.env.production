# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=production
PORT=4002

# ==========================================
# Frontend / CORS
# ==========================================
FRONTEND_URL=https://your-production-domain.com
CORS_ORIGIN=https://your-production-domain.com

# ==========================================
# PostgreSQL Database Configuration
# ==========================================
# Replace with your production PostgreSQL connection string.
# For SSL-enabled hosts, append ?sslmode=require to the URL.
DATABASE_URL=postgresql://postgres:password@localhost:5432/tmsm

# Override pool size for production (optional, default: 10)
# DB_POOL_MAX=20

# ==========================================
# JWT Authentication
# ==========================================
# IMPORTANT: Use strong random secrets in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-strong-64-byte-random-hex-secret
JWT_REFRESH_SECRET=change-this-to-a-different-strong-64-byte-random-hex-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# Rate Limiting & Security
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10000

# ==========================================
# Optional Services & Logging
# ==========================================
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info

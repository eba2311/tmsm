# Development Environment Variables for Docker Compose
# DO NOT use these values in production!

# Application Configuration
NODE_ENV=development
PORT=4000

# Frontend / CORS Configuration
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Configuration (Docker Service)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/tmsm

# Database pool configuration
DB_POOL_MAX=10
DB_SSL=false

# JWT Authentication Secrets (Development Only - Non-Production)
JWT_SECRET=dev_secret_jwt_key_do_not_use_in_production_1234567890abcdefghij1234567890abcdefghij
JWT_REFRESH_SECRET=dev_refresh_secret_do_not_use_in_production_1234567890abcdef1234567890abcdef
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Session Configuration
SESSION_SECRET=dev_session_secret_do_not_use_in_production_1234567890abcdef1234567890abcdef

# Redis Configuration
REDIS_URL=redis://redis:6379

# Logging Configuration
LOG_LEVEL=debug

# Rate Limiting (Relaxed for development)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100000

# Admin Account Seeding (Development Only)
SEED_ADMIN=true
ADMIN_PASSWORD=Admin@1234

# File Upload Configuration
MAX_FILE_SIZE=52428800
UPLOAD_DIR=/app/uploads

# API Configuration
API_PREFIX=/api/v1
API_VERSION=1.0.0

# Development-specific
DEBUG=true
ALLOW_CORS_LOCALHOST=true

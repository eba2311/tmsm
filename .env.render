# ==========================================
# RENDER DEPLOYMENT ENVIRONMENT
# Arba Minch Transport Management System
# ==========================================

# ==========================================
# Application Configuration
# ==========================================
NODE_ENV=production
PORT=4003

# ==========================================
# Frontend / CORS Configuration
# ==========================================
# Update with your Render service URL or custom domain
FRONTEND_URL=https://tmsm-app.onrender.com
CORS_ORIGIN=https://tmsm-app.onrender.com

# ==========================================
# PostgreSQL Database Configuration (Render PostgreSQL)
# ==========================================
# Get this from Render Dashboard > PostgreSQL > Connection String
DATABASE_URL=postgresql://postgres:mysecurepassword123@dpg-co7k8b2gp6cs73afh8kg-a.us-east-1.postgres.render.com:5432/tmsm

# Database SSL Configuration
DB_POOL_MAX=20
DB_SSL=true

# ==========================================
# JWT Authentication Secrets
# ==========================================
# CRITICAL: Generate and store these securely
JWT_SECRET=7f8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f
JWT_REFRESH_SECRET=a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ==========================================
# Rate Limiting & Security
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10000

# ==========================================
# Redis Configuration (Optional - Render Redis)
# ==========================================
# Get from Render Dashboard > Redis > Connection String
REDIS_URL=redis://default:password123@redis-xyz.render.com:6379

# ==========================================
# Logging Configuration
# ==========================================
LOG_LEVEL=info

# ==========================================
# Email Configuration (Optional)
# ==========================================
# Using SendGrid or Mailgun for email
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.your-sendgrid-api-key
SMTP_FROM=noreply@your-domain.com
SMTP_SECURE=false

# ==========================================
# File Upload Configuration
# ==========================================
# For Render, use /tmp for uploads (ephemeral storage)
# For persistent storage, use external S3 or similar
MAX_FILE_SIZE=52428800
UPLOAD_DIR=/tmp/uploads

# ==========================================
# AWS S3 Configuration (Optional - for persistent storage)
# ==========================================
# Only if using S3 for uploads
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=your-bucket-name

# ==========================================
# API Configuration
# ==========================================
API_PREFIX=/api/v1
API_VERSION=1.0.0

# ==========================================
# Session Configuration
# ==========================================
SESSION_SECRET=9z8y7x6w5v4u3t2s1r0q9p8o7n6m5l4k3j2i1h0g9f8e7d6c5b4a3z2y1x0w
SESSION_MAX_AGE=86400000

# ==========================================
# Health Check Configuration
# ==========================================
HEALTH_CHECK_URL=/api/v1/health

# ==========================================
# Deployment-specific
# ==========================================
# Render will automatically set NODE_ENV and PORT
# Do not override these unless you have a specific reason
